# URL pública do site — usada em metadata, sitemap e OpenGraph.
NEXT_PUBLIC_SITE_URL=https://renanaugusto.dev

# Endpoint que recebe o POST do formulário de contato.
# Vazio => o formulário valida e cai para mailto: (funciona em export estático).
# Preenchido => POST JSON { name, email, subject, message }.
# Ex.: https://formspree.io/f/xxxxxxx  |  /api/contact  |  sua Lambda
NEXT_PUBLIC_CONTACT_ENDPOINT=
